{
  "routes": [
    {
      "route": "/",
      "redirect": "/login.html",
      "statusCode": 302
    },
    {
      "route": "/login.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout"
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ]
}