{
  "routes": [
    {
      "route": "/",
      "redirect": "/login.html",
      "statusCode": 302
    },
    {
      "route": "/login.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout"
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/github"
    }
  },
  
"auth": {
  "rolesSource": "roles",
  "identityProviders": {
    "azureActiveDirectory": {
      "registration": {
        "openIdIssuer": "https://login.microsoftonline.com/19da1f3c-d958-44ea-850d-195c1502525c/v2.0"
      }
    }
  }
}

}